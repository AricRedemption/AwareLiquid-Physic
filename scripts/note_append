#!/usr/bin/env python3
"""note_append — GOALS 轮详文追加单命令(轮 857;粘连四犯的机械化消灭)。

保证三件机械事:①新详文换行另起行(block 前置 \\n,轮 846 坑条款);②每行
行首两空格归一;③追加后打印详文块计数(家规 ≤3,超限退出 1 提示折叠)。
退出码:0=成功且计数合规;1=成功但计数超家规;2=结构锚缺失。
"""
import argparse
import re
import sys
from pathlib import Path

ANCHOR = "\n## 心跳语义注记"
DETAIL = re.compile(r"^  轮 \d+ ", re.M)


def main():
    ap = argparse.ArgumentParser(description="GOALS 轮详文追加(防粘连机械化)")
    ap.add_argument("--file", default="docs/loop/GOALS.md")
    ap.add_argument("--round", type=int, required=True)
    ap.add_argument("--text", required=True, help="详文内容,可含换行")
    args = ap.parse_args()
    p = Path(args.file)
    if not p.exists():
        print(f"note_append: {p} 不存在", file=sys.stderr)
        return 2
    text = p.read_text(encoding="utf-8")
    idx = text.find(ANCHOR)
    if idx == -1:
        print("note_append: 缺'心跳语义注记'结构锚", file=sys.stderr)
        return 2
    body = args.text.strip("\n")
    if not body.lstrip().startswith(f"轮 {args.round}"):
        body = f"轮 {args.round} " + body.lstrip()
    normed = "\n".join(("  " + ln.strip()) if ln.strip() else "" for ln in body.split("\n"))
    head = text[:idx]
    if not head.endswith("\n"):
        head += "\n"
    new = head + normed + "\n" + text[idx:]
    n = len(DETAIL.findall(new))
    p.write_text(new, encoding="utf-8")
    print(f"OK: 轮 {args.round} 详文已追加(换行另起行+缩进归一); 详文块计数={n}(家规 ≤3)")
    return 0 if n <= 3 else 1


if __name__ == "__main__":
    sys.exit(main())
