#!/usr/bin/env bash
# goal_check — 目标校验路由器(wave-10 轮 49 建立;轮 88 AMM-013 仪表焊点)
#
# 每轮心跳第一步:
#   0. 跑 balance_gauge(AMM-012/013/014) →
#      本机档欠账(L-debt)存在 → VERDICT: DEBT-FIRST(退出码 4;禁蒸馏/队列迭代,
#      先清欠);云档欠账(C-debt)挂起不阻塞,仅提示
#   1. 读 GOALS.md goal_queue 顶部 → 执行 check_cmd →
#      通过   → VERDICT: ACHIEVED(弹出顶部并写回 GOALS.md,晋升下一位)
#      不通过 → VERDICT: NOT-Achieved(对当前目标迭代一步,未达成不停)
#   2. 队列空时:
#      EXP<20%(窗口≥5)     → VERDICT: MINING-FROZEN(退出码 3;补证据轮,禁蒸馏)
#      否则                 → VERDICT: QUEUE-EMPTY(退出码 2;蒸馏补池)
#
# 退出码:0=ACHIEVED 1=NOT-Achieved 2=QUEUE-EMPTY 3=MINING-FROZEN 4=DEBT-FIRST
# --audit 模式(轮 292 工程硬化):队列完整性审计,只读不路由——
#   数数锚(id 数=check_cmd 数)+空/折叠 check_cmd+重复 id+尾条 id 回显。
#   轮 136/138/142 吞行、轮 62/108 空/折叠命令、轮 240 畸变等手工数数锚
#   检查机械化;每轮提交前 `goal_check --audit`,exit 0 才许提交。0=健康 1=问题
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"
GOALS="$REPO/docs/loop/GOALS.md"
date +%s > "$REPO/.loop-lock"   # 马拉松存活心跳(供 marathon_guard 新鲜度检查)

if [ "${1:-}" = "--audit" ]; then
  python3 - "$GOALS" <<'EOF'
import os, re, subprocess, sys
path = sys.argv[1]
src = open(path).read()
problems = []
whole_ids = re.findall(r"(?m)^\s*- id: (\S+)", src)
whole_cmds = re.findall(r"(?m)^\s*check_cmd: (.*)$", src)
block_m = re.search(r"```yaml\ngoal_queue:\n(.*?)```", src, re.S)
empty_m = re.search(r"(?m)```yaml\ngoal_queue: \[\]\n```", src)
entries = []
if not block_m and not empty_m:
    problems.append("未找到 goal_queue YAML 块")
elif not block_m:
    block_m = empty_m  # goal_queue: [] 空队列形态,块内容按空处理
else:
    cur = None
    for line in block_m.group(1).splitlines():
        m = re.match(r"\s*- id: (\S+)", line)
        if m:
            cur = {"id": m.group(1), "check_cmd": "", "status": ""}
            entries.append(cur); continue
        if cur is not None:
            mm = re.match(r"\s*check_cmd: (.*)", line)
            if mm:
                cur["check_cmd"] = mm.group(1).strip()
            ms = re.match(r"\s*status: (.*)", line)
            if ms:
                cur["status"] = ms.group(1).strip()
    seen = set()
    for e in entries:
        if e["id"] in seen:
            problems.append(f"重复条目 id: {e['id']}(轮 240 畸变/误弹恢复面)")
        seen.add(e["id"])
        c = e["check_cmd"]
        if not c:
            problems.append(f"[{e['id']}] check_cmd 缺失/空(轮 136/138/142 "
                            f"吞行或轮 62 空值:先 git log --all -S 取原文补回)")
        elif c[0] in ">|":
            problems.append(f"[{e['id']}] check_cmd 折叠标量残留 {c!r}(轮 108 变体)")
if len(whole_ids) != len(whole_cmds):
    problems.append(f"数数锚不平衡: '- id' ×{len(whole_ids)} vs 'check_cmd:' "
                    f"×{len(whole_cmds)}(整文件口径;吞行/畸变时二者必分离)")
pending = [e["id"] for e in entries if e["status"].startswith("pr-pending")]
archived = [e["id"] for e in entries if e["status"].startswith("archived-pr")]
tail = entries[-1]["id"] if entries else "(空)"
# AMM-038 条款 5(轮 431):端到端弹出演练——check_cmd 逐条实跑并报告
# 通过率,静态数数锚之外补动态验证(轮 428 实证:55 条死路无人察觉,
# 工具静默失效家族第三例)。演练结果只报告不判死(未达成≠机制坏),
# 但 check_cmd 命令本体不可执行(shell 语法/脚本缺失)判死。
rehearsal, broken = [], []
for e in entries:
    c = e["check_cmd"]
    if not c or c[0] in ">|":
        continue
    try:
        rc = subprocess.call(c, shell=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, timeout=30)
        rehearsal.append((e["id"], rc))
    except Exception as exc:
        broken.append(f"[{e['id']}] check_cmd 执行异常:{exc}")
archive_note = ""
archive_path = path.rsplit("/", 1)[0] + "/QUEUE-ARCHIVE.md"
if os.path.exists(archive_path):
    n_arch = len(re.findall(r"(?m)^\s*- id: (\S+)",
                            open(archive_path).read()))
    archive_note = f",归档 {n_arch}(QUEUE-ARCHIVE.md)"
# AMM 状态行卫生检查(轮 445,轮 439 坑焊点):rsi_night A 维度按提案
# "状态:**…**"行同一行内的"轮 N"归属立案轮——缺轮号=断喂 unattributed
# (工具静默失效家族第四例)。只报告不判死(历史条目由补账轮消化)。
amm_hygiene = ""
amm_path = path.rsplit("/", 1)[0] + "/AMENDMENTS.md"
if os.path.exists(amm_path):
    amm_src = open(amm_path, encoding="utf-8").read()
    amm_missing = []
    for m in re.finditer(r"### (AMM-\d+):[^\n]*\n((?:(?!### ).*\n)*)",
                         amm_src):
        sm = re.search(r"状态:\*\*[^*]*\*\*([^\n]*)", m.group(2))
        if not sm or not re.search(r"轮\s*\d+", sm.group(1)):
            amm_missing.append(m.group(1))
    if amm_missing:
        shown = "/".join(amm_missing[:6]) + ("…" if len(amm_missing) > 6
                                             else "")
        amm_hygiene = (f";[AMM 卫生]{len(amm_missing)} 条提案状态行缺"
                       f"登记轮号({shown})——rsi_night A 维度断喂面,"
                       f"状态行补'轮 N 登记'")
if problems or broken:
    print("AUDIT FAIL:队列完整性问题(禁提交):")
    for p in problems + broken:
        print(f"  - {p}")
    print(f"  [现状] 条目 {len(entries)}(整文件 id ×{len(whole_ids)}/"
          f"check_cmd ×{len(whole_cmds)}),pr-pending {len(pending)},尾条 {tail}")
    sys.exit(1)
passed = sum(1 for _, rc in rehearsal if rc == 0)
print(f"AUDIT OK: 条目 {len(whole_ids)}={len(whole_cmds)}(数数锚平衡),"
      f"pr-pending {len(pending)},尾条 {tail};无空/折叠 check_cmd,无重复 id")
print(f"  [端到端演练] check_cmd 实跑 {len(rehearsal)} 条,通过 {passed},"
      f"未达 {len(rehearsal)-passed}(未达成=状态事实非故障;机制异常才判死)"
      f"{archive_note}")
if amm_hygiene:
    print(f"  {amm_hygiene}")
sys.exit(0)
EOF
  exit $?
fi


python3 - "$GOALS" "$REPO" <<'EOF'
import json, re, subprocess, sys

path, repo = sys.argv[1], sys.argv[2]
gauge = None
try:
    raw = subprocess.run(
        ["python3", f"{repo}/scripts/balance_gauge", "--prd", f"{repo}/docs/PRD.md",
         "--goals", path, "--ledger", f"{repo}/docs/loop/DEBT-LEDGER.md"],
        capture_output=True, text=True, timeout=30)
    gauge = json.loads(raw.stdout)
except Exception as e:   # 仪表故障不阻塞路由,降级为纯队列路由
    print(f"  [gauge 不可用:{e};降级纯队列路由]")

if gauge and gauge.get("debt", {}).get("open_local"):
    print(f"VERDICT: DEBT-FIRST — 本机档欠账 {gauge['debt']['open_local']},"
          f"按 DEBT-LEDGER 顺序清欠(禁蒸馏/禁队列迭代,AMM-007/014)")
    if gauge["debt"].get("open_cloud"):
        print(f"  [C-debt 挂起不阻塞:{gauge['debt']['open_cloud']},"
              f"债龄>5 一次性升级(AMM-014)]")
    sys.exit(4)

src = open(path).read()
block_m = re.search(r"```yaml\ngoal_queue:\n(.*?)```", src, re.S)

def queue_empty_exit():
    # 队列空的两种写法(无 block / block 内空)都必须过 MINING-FROZEN 闸
    if (gauge and gauge.get("window", 0) >= 5
            and gauge.get("exp_ratio") is not None and gauge["exp_ratio"] < 0.20):
        print(f"VERDICT: MINING-FROZEN — EXP={gauge['exp_ratio']}<20%"
              f"(AMM-012):禁蒸馏,先补证据轮(T0 数字判读/T1 探针/台账消化)")
        sys.exit(3)
    print("VERDICT: QUEUE-EMPTY — 取活义务(AMM-038 ⑦ 每拍必产:无空转心跳,"
          "本拍必须从积压取活转成产出心跳)")
    print("  [积压优先级] ①队列弹出条目的消化回填(判读行/N1/派生下一轴)"
          "②dir 在途 K 候选主线入账 ③停车场弱耦合项重准入 ④RSI 三提案"
          "机制工程 ⑤配方组合族(RECIPE_SYNERGIC 已证,组合实验解锁)"
          "⑥新蒸馏族")
    print("  [无活声明] 五项阶梯+积压逐项盘点全空才可声明'无活',且必须附"
          "每项为何此刻不可做的逐项理由;只剩用户门控项(T2/T3/合并/标题)"
          "⇒BLOCKED-HUMAN(诚实等依赖),禁字面计数代替判断")
    # AMM-028(轮 227):价值出口门焊入路由器——蒸馏准入每心跳强制可见
    print("  [AMM-028 门] ①蒸馏准入:条目须带决策耦合声明(哪种结果⇒改变"
          "哪个决策),训练配方族默认关闭;②回灌门:累计≥3 族判『默认配置"
          "非最优』⇒禁开新族,强制组合配方对照(当前回灌候选 RECIPE-SYNTHESIS"
          " 已判 RECIPE_SYNERGIC,回灌 PR=用户线下);③对照类探针 3-seed;"
          "④弱题录(带 ?)不得作 [行动] 唯一依据")
    sys.exit(2)

if not block_m:
    queue_empty_exit()
FIELDS = ("track", "goal", "done_condition", "check_cmd", "status")
entries, cur = [], None
for line in block_m.group(1).splitlines():
    m = re.match(r"\s*- id: (\S+)", line)
    if m:
        cur = {"id": m.group(1), **{f: "" for f in FIELDS}}
        entries.append(cur); continue
    if cur is not None:
        for f in FIELDS:
            mm = re.match(rf"\s*{f}: (.*)", line)
            if mm:
                cur[f] = mm.group(1)
if not entries:
    queue_empty_exit()

# AMM-026(轮 119)+AMM-038(轮 431):任务级状态机——`status: pr-pending`
# 或 `archived-pr` 条目=已完成待合并/已归档终态,**永不迭代**(防重跑探针):
# pr-pending=躺在 PR 区零催促;archived-pr=开 PR 即终态(QUEUE-ARCHIVE.md)。
# 全部跳过 ⇒ 按队列空走取活义务路由。恢复由状态驱动,不依赖散文注记。
chosen, skipped = None, []
for e in entries:
    cmd = e["check_cmd"].strip()
    if not cmd or cmd[0] in ">|":
        # 空 check_cmd 时 subprocess.call("") 返回 0 ⇒ 假阳性 ACHIEVED 误弹
        # (轮 62 实付 1 cycle)。变体(轮 108 实付 1 cycle):check_cmd 用了
        # YAML 折叠标量 `>-`,单行解析器把 ">-" 当命令本体,shell 将其解释为
        # 重定向——静默创建名为 "-" 的空文件且 exit 0 ⇒ 假 ACHIEVED 误弹。
        # 队列字段契约:check_cmd 必须单行字面命令;以 > 或 | 开头的值不执行。
        print(f"VERDICT: NOT-Achieved — [{e['id']}] check_cmd 为空或 YAML 折叠标量"
              f"残留({e['check_cmd']!r}),拒绝执行防假阳性,按未达成路由;"
              f"请改单行命令")
        print(f"  done_condition: {e['done_condition']}")
        sys.exit(1)
    rc = subprocess.call(e["check_cmd"], shell=True,
                         cwd=path.rsplit("/docs", 1)[0])
    if rc == 0:
        chosen = e
        break
    if ((e.get("status") or "").startswith("pr-pending")
            or (e.get("status") or "").startswith("archived-pr")):
        skipped.append(e["id"])
        print(f"  [skip] {e['id']}: 终态条目(pr-pending/archived-pr)零催促"
              f"跳过(AMM-026/AMM-038)")
        continue
    print(f"VERDICT: NOT-Achieved — 对 [{e['id']}] {e['goal']} 迭代一步")
    print(f"  done_condition: {e['done_condition']}")
    sys.exit(1)
if chosen is None:
    queue_empty_exit()

rest = [e for e in entries if e is not chosen]

def fmt(e):
    lines = (f"- id: {e['id']}\n"
            f"    track: {e['track']}\n"
            f"    goal: {e['goal']}\n"
            f"    done_condition: {e['done_condition']}\n"
            f"    check_cmd: {e['check_cmd']}")
    if e.get("status"):
        lines += f"\n    status: {e['status']}"
    return lines

new_block = ("```yaml\ngoal_queue:\n" + "\n".join(fmt(e) for e in rest) + "\n```") if rest \
            else "```yaml\ngoal_queue: []\n```"
open(path, "w").write(src.replace(block_m.group(0), new_block))
nxt = rest[0]["id"] if rest else "(队列空,进入文献扫描补池)"
print(f"VERDICT: ACHIEVED — 弹出 {chosen['id']},晋升 {nxt}")
EOF
