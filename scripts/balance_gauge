#!/usr/bin/env python3
"""balance_gauge — AMM-012 平衡仪表计量器(通用规则,数值自动计算不手工维护)

EXP 占比:PRD §19 轮记录头分类(滑动窗口,默认 10):
  mining   = 蒸馏补池轮
  evidence = 算力轮(T1/T2 执行+判读)或非零算力的判读/达成轮
  t0       = 零算力判读/写作轮(证据性存疑,单列不计入 EXP 分母的警告值)
WIP:GOALS.md goal_queue 的 [行动] 条目数(上限 2,AMM-012)。
DEBT:DEBT-LEDGER.md 台账行解析(D_count/D_min/digest_rate,AMM-009/013)。

用法: ./scripts/balance_gauge [--window 10] [--prd docs/PRD.md]
      [--goals docs/loop/GOALS.md] [--ledger docs/loop/DEBT-LEDGER.md]
输出: 一行 JSON(stdout)。规则不变式在此计算,文档只引用结论,不复述实例值。
"""
import argparse
import json
import re
import sys
from pathlib import Path

WIN_PAT = re.compile(r"^\*\*(?:轮\s*\d+|D-\d+|[A-Z][A-Za-z0-9-]*)[^*]*（[^）]*）\*\*")
STATUS_PAT = re.compile(r"^(open|closed|void)\b")
EST_PAT = re.compile(r"~?\s*(\d+)(?:-(\d+))?\s*min")
TIER_PAT = re.compile(r"T([123])\b")
ROUND_NUM_PAT = re.compile(r"轮\s*(\d+)")


def classify(header: str) -> str:
    if "蒸馏补池" in header:
        return "mining"
    if "算力轮" in header or ("零算力" not in header and
                              ("判读" in header or "达成" in header)):
        return "evidence"
    return "t0"


def parse_rounds(prd_text: str) -> list:
    """轮 97 修复(坑:PRD §19 多时代分层布局,文件序≠时间序,旧版
    rounds[-n:] 窗口取到的是最老 10 轮,EXP 恒 0 误触发 MINING-FROZEN)。
    现按头部内"轮 N"编号取最近 N 轮;ID 型判读头(GRAD-PATH/SCAN-AUDIT/
    R1C-AGG…)同样匹配;无编号头部继承最近前驱编号(D-1..D-4 紧邻
    轮 88+ 区段的既有布局)。"""
    rounds = []
    for idx, line in enumerate(prd_text.splitlines()):
        if WIN_PAT.match(line.strip()):
            nums = [int(x) for x in ROUND_NUM_PAT.findall(line)]
            rounds.append({"header": line.strip()[:80], "class": classify(line),
                           "key": max(nums) if nums else None, "idx": idx})
    last = 0
    for r in rounds:
        if r["key"] is None:
            r["key"] = last
        else:
            last = r["key"]
    return rounds


def parse_wip(goals_text: str) -> int:
    """WIP = 进行中队列条目数(AMM-012 上限 2)。AMM-026(轮 119)起,
    带 `status: pr-pending` 的条目=已完成待合并,**不计入 WIP**——
    否则用户侧合并延迟会造成 WIP 假报警。"""
    in_queue = False
    wip = 0
    seen_entry = False
    has_status = False
    for line in goals_text.splitlines():
        s = line.strip()
        if s.startswith("goal_queue:"):
            in_queue = True
            continue
        if in_queue and s.startswith("```"):
            if seen_entry and not has_status:
                wip += 1
            break
        if not in_queue:
            continue
        if re.match(r"^\s*-\s*id:", line):
            if seen_entry and not has_status:
                wip += 1
            seen_entry, has_status = True, False
        elif re.match(r"^\s*status:", line):
            has_status = True
    return wip


def parse_debts(ledger_text: str) -> dict:
    """AMM-014 欠账分级:T1/T2 ⇒ L-debt(阻塞 DEBT-FIRST);T3 ⇒ C-debt
    (挂起不阻塞);档位未知按本机档保守处理。"""
    rows = []
    for line in ledger_text.splitlines():
        if not line.lstrip().startswith("| D-"):
            continue
        rows.append([c.strip() for c in line.split("|")])
    out = {"open_local": [], "open_cloud": [], "closed": 0, "void": 0,
           "d_min_local": 0, "d_min_cloud": 0}
    for cells in rows:
        did = next((c for c in cells if re.match(r"^D-\d+$", c)), None)
        if did is None:
            continue
        raw = next((c for c in cells if STATUS_PAT.match(c.strip("*_ "))), "open")
        status = raw.strip("*_ ")   # next() 返回原始 cell,判断前必须剥壳
        tier = next((TIER_PAT.search(c).group(0) for c in cells
                     if TIER_PAT.search(c)), "T1")
        if status.startswith("open"):
            m = next((EST_PAT.match(c.strip()) for c in cells
                      if EST_PAT.match(c.strip())), None)
            est = int(m.group(2) or m.group(1)) if m else 0
            local = tier in ("T1", "T2")
            (out["open_local"] if local else out["open_cloud"]).append(did)
            if est:
                if local:
                    out["d_min_local"] += est
                else:
                    out["d_min_cloud"] += est
        elif status.startswith("closed"):
            out["closed"] += 1
        else:
            out["void"] += 1
    total = (len(out["open_local"]) + len(out["open_cloud"])
             + out["closed"] + out["void"])
    out["count_open"] = len(out["open_local"]) + len(out["open_cloud"])
    out["digest_rate"] = round((out["closed"] + out["void"]) / total, 3) if total else None
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", type=int, default=10)
    ap.add_argument("--prd", default="docs/PRD.md")
    ap.add_argument("--goals", default="docs/loop/GOALS.md")
    ap.add_argument("--ledger", default="docs/loop/DEBT-LEDGER.md")
    args = ap.parse_args()

    rounds = parse_rounds(Path(args.prd).read_text(encoding="utf-8"))
    ranked = sorted(rounds, key=lambda r: (-r["key"], r["idx"]))
    win = ranked[:args.window]
    n = len(win)
    ev = sum(1 for r in win if r["class"] == "evidence")
    mining = sum(1 for r in win if r["class"] == "mining")
    t0 = sum(1 for r in win if r["class"] == "t0")
    exp_ratio = round(ev / n, 3) if n else None
    wip = parse_wip(Path(args.goals).read_text(encoding="utf-8"))
    debt = parse_debts(Path(args.ledger).read_text(encoding="utf-8"))

    alarms = []
    if debt["open_local"]:
        alarms.append(f"DEBT-FIRST:本机档欠账{debt['open_local']},"
                      f"禁蒸馏禁队列迭代先清欠(AMM-007/014)")
    if debt["open_cloud"]:
        alarms.append(f"C-DEBT:云档欠账{debt['open_cloud']}挂起不阻塞,"
                      f"债龄>5一次性升级(AMM-014)")
    if n >= 5 and exp_ratio is not None and exp_ratio < 0.20:
        alarms.append("EXP<20%:冻结蒸馏,先补证据轮(AMM-012)")
    if wip > 2:
        alarms.append(f"WIP={wip}>2:蒸馏只许产[坐标](AMM-012)")

    print(json.dumps({"window": n, "evidence": ev, "mining": mining, "t0": t0,
                      "exp_ratio": exp_ratio, "wip": wip, "debt": debt,
                      "alarms": alarms,
                      "caveat": "文本启发式分类;T0 带数字判读是否计证据由消化轮人工终判"},
                     ensure_ascii=False))


if __name__ == "__main__":
    sys.exit(main())

